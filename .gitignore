# Cargo build output
/target/
**/target/

# Rust formatting backups
**/*.rs.bk

# Build / check / run logs
*.log
*.err
/run-logs/
/log/
stdout.txt
stderr.txt
loop_run.out.txt
build_all.txt
build_core.txt
test_core.txt
test_log.txt
test_ws.txt
tmp_test.txt

# Server boot / e2e test logs
server_test.*
server_e2e.*
server_e2e[3-9].*
server_run.*
server_dbg.*
server_dbg2.*

# Client boot / e2e test logs
client_e2e.*
client_e2e[3-9].*
client_dbg.*
client_dbg2.*

# Temporary / duplicate files
README copy.md
*.tmp

# IDE configurations
.idea/
.vscode/

# AI agent / planning tools
.mavis/
.harness/

# Temporary build artifacts
.opencode/

# Screenshots generated during closed-loop iteration
screenshots/
!screenshots/_archive/

# Obsidian configurations
docs/**/*.obsidian/
document/**/*.obsidian/

# Python / Blender script caches
__pycache__/
*.py[cod]
*.blend1
*.blend2

# Node.js artifacts
node_modules/
package-lock.json

# do_check.bat 输出（防止 do_check.bat 回归时漏管）
cargo_check_out.txt
